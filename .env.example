# Optional: URL of your own backend endpoint that calls an LLM. See src/services/aiService.js for the contract.
# VITE_AI_API_URL=https://your-server.example.com/api/ai-teacher

# ---- Course Materials (Supabase) — PUBLIC values, safe in the browser (Row Level Security protects the data) ----
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- Seed script only (npm run seed) — SECRET, never put these in Vercel/browser variables or commit them ----
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# SEED_DEMO_USERS=true            # also create admin / teacher / student demo accounts
# SEED_PASSWORD=choose-a-strong-password   # optional; a random one is generated and printed if omitted
